# Copiá este archivo como .env. El .env real nunca se sube a git.
# No hace falta ninguna clave: la IA se llama con Claude Code, usando la sesión iniciada en esta compu.

# Modelo que usa Claude Code (sonnet, opus, haiku...)
POSTULA_MODELO=sonnet
